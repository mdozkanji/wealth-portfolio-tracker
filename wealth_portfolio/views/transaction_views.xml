<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transaction_list" model="ir.ui.view">
        <field name="name">portfolio.transaction.list</field>
        <field name="model">portfolio.transaction</field>
        <field name="arch" type="xml">
            <list string="Ledger" create="0" edit="0" delete="0"
                  decoration-muted="is_reversed or reversal_of_id">
                <field name="date"/>
                <field name="name"/>
                <field name="portfolio_id"/>
                <field name="asset_id"/>
                <field name="tx_type"/>
                <field name="quantity" digits="[16, 4]"/>
                <field name="price" digits="[16, 6]"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_amount"/>
                <field name="is_reversed" column_invisible="1"/>
                <field name="reversal_of_id" optional="show"/>
                <field name="create_uid" optional="show" string="Recorded by"/>
            </list>
        </field>
    </record>

    <record id="view_transaction_form" model="ir.ui.view">
        <field name="name">portfolio.transaction.form</field>
        <field name="model">portfolio.transaction</field>
        <field name="arch" type="xml">
            <form string="Ledger entry">
                <header>
                    <button name="action_reverse" type="object" string="Reverse"
                            class="btn-secondary"
                            confirm="Post an opposite entry that cancels this one? The original stays in the ledger."
                            invisible="not id or is_reversed or reversal_of_id or my_role not in ('owner', 'editor')"/>
                </header>
                <sheet>
                    <field name="my_role" invisible="1"/>
                    <field name="is_reversed" invisible="1"/>
                    <widget name="web_ribbon" title="Reversed" bg_color="text-bg-warning" invisible="not is_reversed"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="id" options="{'no_create': True}"/>
                            <field name="tx_type" readonly="id"/>
                            <field name="date" readonly="id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="quantity" digits="[16, 4]" readonly="id"/>
                            <field name="price" digits="[16, 6]" readonly="id"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" readonly="id"/>
                        <field name="reversal_of_id" invisible="not reversal_of_id"/>
                    </group>
                    <div class="text-muted" invisible="not id">
                        Ledger entries are immutable. To correct a mistake, use Reverse.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_transaction_search" model="ir.ui.view">
        <field name="name">portfolio.transaction.search</field>
        <field name="model">portfolio.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="portfolio_id"/>
                <filter name="buys" string="Buys" domain="[('tx_type', '=', 'buy')]"/>
                <filter name="sells" string="Sells" domain="[('tx_type', '=', 'sell')]"/>
                <separator/>
                <filter name="active_entries" string="Not reversed" domain="[('is_reversed', '=', False), ('reversal_of_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_portfolio" string="Portfolio" context="{'group_by': 'portfolio_id'}"/>
                    <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'tx_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transaction" model="ir.actions.act_window">
        <field name="name">Ledger</field>
        <field name="res_model">portfolio.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
