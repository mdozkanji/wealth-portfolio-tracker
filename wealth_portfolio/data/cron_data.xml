<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- One job for all providers: one batched CoinGecko request, plus one Finnhub request per stock symbol (max 50/run). -->
        <record id="ir_cron_sync_asset_prices" model="ir.cron">
            <field name="name">Wealth Portfolio: sync market prices (CoinGecko + Finnhub)</field>
            <field name="model_id" ref="model_portfolio_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_prices()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
